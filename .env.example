# ChainLens config
# Copy to .env and fill in.

# Etherscan multichain API key (free tier ok)
# Get it at: https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Optional: alternative scam-check API (no auth required for free tier)
# https://gopluslabs.io/
GOPLUS_API_KEY=

# LLM provider — pick one
# Option 1: 9router (local, free)
LLM_PROVIDER=9router
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=
NINEROUTER_MODEL=jagrescombo

# Option 2: OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Server config
HOST=0.0.0.0
PORT=8080
